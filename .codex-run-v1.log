+        VIEWER_OWNERSHIP.unlink(missing_ok=True)
+        subprocess.run(["systemctl", "--user", "stop", VIEWER_UNIT], capture_output=True)
+        viewer_stopped = True
+    if LIVE_STATE.exists():
+        raise RuntimeError("live bridge state file remained after stop")
