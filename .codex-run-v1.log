+    fn install_live_frame(&mut self, frame: LiveFrame) {
+        let matches = self.exported_graph.as_ref().is_some_and(|(name, graph)| {
+            name == &frame.graph.name
+                && graph.cells.len() == frame.graph.cells
+                && graph.links.len() == frame.graph.links
+                && graph.sha256 == frame.graph.sha256
+        });
+        if !matches {
+            set_graph_status("live: graph mismatch", true);
+            if let Some(gpu) = self.gpu.as_mut() {
+                gpu.set_live_surfaces(&[]);
+                gpu.set_live_lines(&[]);
+            }
+            self.live_frame = Some(frame);
+            self.request_redraw();
+            return;
+        }
+        let graph = &self.exported_graph.as_ref().expect("matching graph").1;
+        let live = overlay::build_live(graph, &frame);
+        if let Some(gpu) = self.gpu.as_mut() {
+            gpu.set_live_surfaces(&live.surfaces);
+            gpu.set_live_lines(&live.lines);
+        }
+        if self.follow_live && let Some(bot) = frame.bots.first() {
+            let center = Vec3::from_array(bot.pos) + Vec3::Z * 24.0;
+            self.camera.frame(
+                center - Vec3::new(96.0, 96.0, 64.0),
+                center + Vec3::new(96.0, 96.0, 96.0),
+            );
+        }
+        self.live_frame = Some(frame);
+        self.refresh_graph_status();
+        self.request_redraw();
+    }
+
+    fn clear_live(&mut self, reason: &str) {
+        self.live_frame = None;
+        if let Some(gpu) = self.gpu.as_mut() {
+            gpu.set_live_surfaces(&[]);
+            gpu.set_live_lines(&[]);
+        }
+        set_graph_status(reason, true);
+        self.request_redraw();
