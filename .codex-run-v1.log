+//! Versioned live-frame contract sent by qw-fasttrack's loopback bridge.
+
+use serde::Deserialize;
+
+pub const SCHEMA_V1: &str = "qw-live-frame/1";
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct LiveFrame {
+    pub schema: String,
+    pub seq: u64,
+    pub t_mono: f64,
+    pub graph: LiveGraph,
+    pub attempt_id: u64,
+    pub bots: Vec<LiveBot>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct LiveGraph {
+    pub name: String,
+    pub cells: usize,
+    pub links: usize,
+    pub sha256: String,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct LiveBot {
+    pub ent: u32,
+    pub pos: [f32; 3],
+    pub speed: f32,
+    pub cell_id: Option<u32>,
+    pub used: LiveUsed,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct LiveUsed {
+    pub cells: Vec<u32>,
+    pub links: Vec<u32>,
+}
+
+impl LiveFrame {
+    pub fn parse(json: &str) -> Result<Self, String> {
+        let frame: Self = serde_json::from_str(json).map_err(|error| error.to_string())?;
+        if frame.schema != SCHEMA_V1 {
+            return Err(format!("unsupported live schema {:?}; expected {SCHEMA_V1}", frame.schema));
+        }
+        if !frame.t_mono.is_finite()
+            || frame.bots.iter().any(|bot| {
+                !bot.speed.is_finite() || bot.pos.iter().any(|coordinate| !coordinate.is_finite())
+            })
+        {
+            return Err("live frame contains non-finite telemetry".into());
+        }
+        Ok(frame)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::LiveFrame;
+
+    #[test]
+    fn parses_v1_frame_with_graph_fingerprint() {
+        let frame = LiveFrame::parse(
+            r#"{"schema":"qw-live-frame/1","seq":2,"t_mono":1.25,
+            "graph":{"name":"fixture","cells":2,"links":1,"sha256":"0123456789abcdef"},
+            "attempt_id":3,"bots":[{"ent":1,"pos":[1,2,3],"speed":420,
+            "cell_id":7,"used":{"cells":[7],"links":[9]}}]}"#,
+        ).unwrap();
+        assert_eq!(frame.graph.sha256, "0123456789abcdef");
+        assert_eq!(frame.bots[0].used.links, [9]);
+    }
+
+    #[test]
+    fn rejects_unknown_schema() {
+        assert!(LiveFrame::parse(
+            r#"{"schema":"qw-live-frame/2","seq":0,"t_mono":0,
+            "graph":{"name":"x","cells":0,"links":0,"sha256":"x"},
+            "attempt_id":0,"bots":[]}"#,
+        ).is_err());
+    }
+}
