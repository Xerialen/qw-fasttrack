0069: class Control:
0070:     """Newline-JSON control client (single connection, request/reply + events)."""
0071: 
0072:     def __init__(self, host: str = "127.0.0.1", port: int = CONTROL_PORT, timeout: float = 30.0):
0073:         self._socket = socket.create_connection((host, port), timeout=timeout)
0074:         self._next_id = 1
0075:         self._buf = b""
