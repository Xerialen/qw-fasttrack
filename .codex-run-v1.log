+            buf += chunk
+        reply = json.loads(buf.split(b"\n", 1)[0])
+        if reply.get("ok") is not True or reply.get("nonce") != state["nonce"]:
+            raise ValueError("live proxy nonce mismatch")
+        return sock
+    except Exception:
+        sock.close()
+        raise
