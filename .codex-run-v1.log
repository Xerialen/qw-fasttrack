+fn wire_cuboid(out: &mut Vec<ColorVertex>, center: Vec3, half: Vec3, color: [f32; 3]) {
+    let p = |x: f32, y: f32, z: f32| center + Vec3::new(x * half.x, y * half.y, z * half.z);
+    let corners = [
+        p(-1., -1., -1.), p(1., -1., -1.), p(1., 1., -1.), p(-1., 1., -1.),
+        p(-1., -1., 1.), p(1., -1., 1.), p(1., 1., 1.), p(-1., 1., 1.),
+    ];
+    for (a, b) in [
+        (0,1),(1,2),(2,3),(3,0),(4,5),(5,6),(6,7),(7,4),
+        (0,4),(1,5),(2,6),(3,7),
+    ] {
+        line(out, corners[a], corners[b], color);
+    }
+}
