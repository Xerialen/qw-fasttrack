1502:     fn window_event(&mut self, event_loop: &ActiveEventLoop, _id: WindowId, event: WindowEvent) {
1503:         match event {
1504:             WindowEvent::CloseRequested => event_loop.exit(),
1505:             WindowEvent::Resized(size) => {
1506:                 if let Some(gpu) = &mut self.gpu {
1507:                     gpu.resize(size.width, size.height);
1508:                 }
1509:             }
1510:             WindowEvent::RedrawRequested => {
1511:                 let mut rendered = None;
1512:                 if let Some(gpu) = &mut self.gpu {
1513:                     let view_proj = self.camera.view_proj(gpu.aspect());
1514:                     gpu.render(view_proj);
1515:                     let (width, height, mesh, liquid, surfaces, lines, frames) = gpu.diagnostics();
1516:                     set_web_frame(width, height, mesh, liquid, surfaces, lines, frames);
1517:                     rendered = Some(view_proj);
1518:                 }
1519:                 if let Some(view_proj) = rendered {
1520:                     let markers = self
1521:                         .overlay
1522:                         .as_ref()
1523:                         .filter(|(_, document)| document.map == self.map_name)
1524:                         .map_or(&[][..], |(_, document)| document.markers.as_slice());
1525:                     update_marker_labels(markers, view_proj);
1526:                     let exported = self
1527:                         .exported_graph
1528:                         .as_ref()
1529:                         .filter(|(_, document)| document.map == self.map_name)
1530:                         .map(|(_, document)| document);
1531:                     update_editor_projection(
1532:                         self.editor_enabled.then_some(exported).flatten(),
1533:                         view_proj,
1534:                     );
1535:                 }
1536:             }
1537:             WindowEvent::CursorMoved { position, .. } => {
1538:                 let cursor = Vec2::new(position.x as f32, position.y as f32);
1539:                 self.cursor_position = Some(cursor);
1540:                 self.drag_takeoff_to(cursor);
1541:                 self.drag_annotation_to(cursor);
1542:             }
1543:             WindowEvent::MouseInput {
1544:                 state,
1545:                 button: MouseButton::Left,
1546:                 ..
1547:             } => {
1548:                 if state == ElementState::Pressed {
1549:                     if !self.annotation_pointer_down() {
1550:                         self.editor_pointer_down();
1551:                     }
1552:                 } else {
1553:                     self.finish_annotation_drag();
1554:                     self.drag_takeoff = None;
1555:                 }
1556:             }
1557:             WindowEvent::MouseInput {
1558:                 state,
1559:                 button: MouseButton::Right,
1560:                 ..
1561:             } => self.set_looking(state == ElementState::Pressed),
1562:             WindowEvent::KeyboardInput { event, .. } => {
1563:                 if let PhysicalKey::Code(code) = event.physical_key {
1564:                     let pressed = event.state == ElementState::Pressed;
1565:                     match code {
1566:                         KeyCode::ShiftLeft | KeyCode::ShiftRight => self.fast = pressed,
1567:                         KeyCode::Escape if pressed => self.set_looking(false),
1568:                         KeyCode::KeyG if pressed && !event.repeat => self.camera_place(false),
1569:                         KeyCode::KeyP if pressed && !event.repeat => self.camera_place(true),
1570:                         KeyCode::KeyF if pressed && !event.repeat => {
1571:                             if let Some((mins, maxs)) = self.map_bounds {
1572:                                 self.camera.frame(mins, maxs);
