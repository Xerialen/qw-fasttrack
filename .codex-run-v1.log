index 2c4255b2ece0ba7bf7a9ab3eee8b80ba597f5847..87cff2b5666db4f5c39cf2f72a545ac41d405b75
--- a/C:/Users/benya/projects/quakeworld/route-lab-viewer-live/qw-nav-viewer/nav-viewer/Cargo.toml
