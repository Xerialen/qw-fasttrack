0101: impl Default for FlyCamera {
0102:     fn default() -> Self {
0103:         Self {
0104:             position: Vec3::new(-256.0, 0.0, 128.0),
0105:             yaw: 0.0,
0106:             pitch: -0.25,
0107:         }
0108:     }
0109: }
0110: 
0111: impl FlyCamera {
0112:     fn direction(&self) -> Vec3 {
0113:         let (cp, sp) = (self.pitch.cos(), self.pitch.sin());
0114:         Vec3::new(cp * self.yaw.cos(), cp * self.yaw.sin(), sp)
0115:     }
0116:     fn view_proj(&self, aspect: f32) -> Mat4 {
0117:         Mat4::perspective_rh(60_f32.to_radians(), aspect.max(0.01), 3.0, 32_768.0)
0118:             * Mat4::look_to_rh(self.position, self.direction(), Vec3::Z)
0119:     }
0120:     fn frame(&mut self, mins: Vec3, maxs: Vec3) {
0121:         let center = (mins + maxs) * 0.5;
0122:         let extent = (maxs - mins).length().max(64.0);
0123:         self.position = center + Vec3::new(0.82, 0.92, 0.68).normalize() * extent * 0.63;
0124:         let direction = (center - self.position).normalize_or(Vec3::NEG_X);
0125:         self.yaw = direction.y.atan2(direction.x);
0126:         self.pitch = direction.z.asin().clamp(-1.54, 1.54);
0127:     }
0128: }
