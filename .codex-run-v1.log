+def _remove_live_state(expected_nonce: str | None = None) -> None:
+    try:
+        if expected_nonce is not None:
+            current = json.loads(LIVE_STATE.read_text(encoding="utf-8"))
+            if current.get("nonce") != expected_nonce:
