+                raise RuntimeError(f"viewer stopped before readiness: {logs[-3000:]}")
+            time.sleep(1.0)
+        if not _http_ready(8090, timeout=2.0):
+            raise TimeoutError("viewer did not answer on 8090 within 180s")
+    else:
+        VIEWER_OWNERSHIP.unlink(missing_ok=True)
