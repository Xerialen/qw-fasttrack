+def _connect_live_proxy(state: dict, timeout: float) -> socket.socket:
+    pid = int(state["pid"])
+    os.kill(pid, 0)
+    sock = socket.create_connection(("127.0.0.1", int(state["proxy"])), timeout=timeout)
+    try:
+        sock.settimeout(timeout)
