diff --git a/fasttrack/tests/test_link_attribution.py b/fasttrack/tests/test_link_attribution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b19929f0f71dd9ffa1eab443edbe3de375c85aa8
--- /dev/null
+++ b/fasttrack/tests/test_link_attribution.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+import asyncio
+import json
+import sys
+import unittest
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+
+from live_bridge import Attribution, GraphContract, LiveBridge  # noqa: E402
+
+
+GRAPH = Path("/mnt/c/Users/benya/projects/quakeworld/route-lab-viewer-live/qw-nav-viewer/overlays/fasttrack-graph.json")
+
+
+class LinkAttributionTests(unittest.TestCase):
+    def test_recorded_sng_sequence_attributes_planted_link_once_per_attempt(self):
+        fixture = json.loads((HERE / "fixtures" / "sng_status_sequence.json").read_text())
+        graph = GraphContract.load(GRAPH)
+        state = Attribution()
+        for sample in fixture["samples"]:
+            if sample["cell"] is not None:
+                state.observe(sample["cell"], sample["t"], graph)
+        planted = fixture["planted_link_id"]
+        self.assertIn(planted, state.used_links)
+        self.assertEqual(list(sorted(state.used_links)).count(planted), 1)
+        state.reset()
+        self.assertEqual(state.used_links, set())
+
+
+class ProxyRoutingTests(unittest.IsolatedAsyncioTestCase):
+    async def asyncSetUp(self):
+        self.received: asyncio.Queue[tuple[int, str]] = asyncio.Queue()
+        self.server_writer = None
+
+        async def fake_server(reader, writer):
+            self.server_writer = writer
+            try:
+                while line := await reader.readline():
+                    sid, command = line.decode().strip().split(" ", 1)
+                    await self.received.put((int(sid), command))
+            finally:
+                writer.close()
+
+        self.fake = await asyncio.start_server(fake_server, "127.0.0.1", 31990)
+        port = 31990
+        self.bridge = LiveBridge(GraphContract.load(GRAPH), control_port=port)
+        await asyncio.wait_for(self.bridge.connect_upstream(), 3)
+        self.proxy, self.bridge.proxy_port = await self.bridge._bind_server(
+            self.bridge._proxy_client, 32000
+        )
+
+    async def asyncTearDown(self):
+        self.proxy.close()
+        await self.proxy.wait_closed()
+        await self.bridge.close()
+        self.fake.close()
+        await self.fake.wait_closed()
+
+    async def test_two_clients_share_global_sids_and_receive_original_ids(self):
+        r1, w1 = await asyncio.open_connection("127.0.0.1", self.bridge.proxy_port)
+        r2, w2 = await asyncio.open_connection("127.0.0.1", self.bridge.proxy_port)
+        w1.write(b"7 status\n")
+        w2.write(b"7 cell 0 0 0\n")
+        await asyncio.gather(w1.drain(), w2.drain())
+        first = await asyncio.wait_for(self.received.get(), 1)
+        second = await asyncio.wait_for(self.received.get(), 1)
+        self.assertNotEqual(first[0], second[0])
+        assert self.server_writer is not None
+        for sid, _ in (second, first):
+            self.server_writer.write(
+                json.dumps({"id": sid, "ok": True, "data": {"sid": sid}}).encode() + b"\n"
+            )
+        await self.server_writer.drain()
+        replies = await asyncio.gather(r1.readline(), r2.readline())
+        parsed = [json.loads(reply) for reply in replies]
+        self.assertEqual([reply["id"] for reply in parsed], [7, 7])
+        w1.close()
+        w2.close()
+        await asyncio.wait_for(asyncio.gather(w1.wait_closed(), w2.wait_closed()), 2)
+
+    async def test_disconnect_cleans_pending_and_late_reply_is_discarded(self):
+        reader, writer = await asyncio.open_connection("127.0.0.1", self.bridge.proxy_port)
+        _ = reader
+        writer.write(b"9 status\n")
+        await writer.drain()
+        sid, _ = await asyncio.wait_for(self.received.get(), 1)
+        writer.close()
+        await asyncio.wait_for(writer.wait_closed(), 2)
+        for _ in range(50):
+            if sid not in self.bridge.pending:
+                break
+            await asyncio.sleep(0.01)
+        self.assertNotIn(sid, self.bridge.pending)
+        assert self.server_writer is not None
+        self.server_writer.write(json.dumps({"id": sid, "ok": True, "data": {}}).encode() + b"\n")
+        await self.server_writer.drain()
+        await asyncio.sleep(0.05)
+        self.assertNotIn(sid, self.bridge.pending)
+
+
+if __name__ == "__main__":
+    unittest.main()

diff --git a/C:/Users/benya/projects/quakeworld/route-lab-viewer-live/qw-nav-viewer/RUNBOOK.md b/C:/Users/benya/projects/quakeworld/route-lab-viewer-live/qw-nav-viewer/RUNBOOK.md
index 04f4ccec470660ff7d40aa91bdc5b9c07dbfec47..34316d85ca4adcf92da32c51c15a9c6d46be5843
--- a/C:/Users/benya/projects/quakeworld/route-lab-viewer-live/qw-nav-viewer/RUNBOOK.md
+++ b/C:/Users/benya/projects/quakeworld/route-lab-viewer-live/qw-nav-viewer/RUNBOOK.md
@@ -239,10 +239,31 @@
   "map": "dm3",
   "grid": 32.0,
   "cells": [[448.0, 192.0, 56.0]],
-  "links": [[0, 1, "Walk", 0.1]]
+  "cell_ids": [4711],
+  "links": [[0, 1, "Walk", 0.1]],
+  "link_ids": [50259]
 }
 ```
 
+`cell_ids` and `link_ids` are optional parallel arrays used by the live viewer.
+Their lengths must match `cells`/`links`, and every ID must be unique. A
+mismatch or duplicate leaves the static graph usable but disables both live-ID
+maps and emits a console warning. Link kinds are parsed case-insensitively and
+normalized to the canonical spelling above.
+
+### Live fasttrack layer
+
+Add `?graph=<name>&live=<port>` to connect directly to
+`ws://127.0.0.1:<port>`. Without `live`, no WebSocket is created and static
+behavior is unchanged. Live frames use `qw-live-frame/1`; their 16-character
+graph SHA-256 fingerprint must match the exact fetched graph bytes. A mismatch
+shows `live: graph mismatch` and draws no live layer.
+
+Matching frames add two retained buffers without rebuilding the static graph:
+bright active/dim used cells in the surface buffer, and yellow-to-red used
+links plus an axis-aligned bot box in the line buffer. Press `L` to toggle
+follow-camera for the first bot in each frame. `F` remains frame-map.
+
 Traversal-aware dumps may add `speed_jump_payloads`, `speed_jump_traversals`, and
 `speed_jump_traversal_provenance`. Rendering ignores those sidecars, while audit tools use them to
 bind a displayed link to its payload or `SpeedJumpTraversal`, ground-turn contract, launchbox,
