+    fn build_live_id_maps(&mut self) {
+        let lengths_match = self.cell_ids.len() == self.cells.len()
+            && self.link_ids.len() == self.links.len();
+        let cell_index_by_id = unique_index(&self.cell_ids);
+        let link_index_by_id = unique_index(&self.link_ids);
+        if !lengths_match || cell_index_by_id.is_none() || link_index_by_id.is_none() {
+            log::warn!(
+                "live-id maps disabled: cells {}/{}, links {}/{}; IDs must match lengths and be unique",
+                self.cell_ids.len(),
+                self.cells.len(),
+                self.link_ids.len(),
+                self.links.len()
+            );
+            self.cell_index_by_id.clear();
+            self.link_index_by_id.clear();
+            return;
+        }
+        self.cell_index_by_id = cell_index_by_id.unwrap_or_default();
+        self.link_index_by_id = link_index_by_id.unwrap_or_default();
+    }
+
     pub fn cell(&self, index: usize) -> Vec3 {
         Vec3::from_array(self.cells[index])
     }
 }
 
 pub fn kind_index(kind: &str) -> Option<usize> {
-    LINK_KINDS.iter().position(|candidate| *candidate == kind)
+    LINK_KINDS
+        .iter()
+        .position(|candidate| candidate.eq_ignore_ascii_case(kind))
 }
 
+fn unique_index(ids: &[u32]) -> Option<HashMap<u32, usize>> {
+    let mut result = HashMap::with_capacity(ids.len());
+    for (index, id) in ids.iter().copied().enumerate() {
+        if result.insert(id, index).is_some() {
+            return None;
+        }
+    }
+    Some(result)
+}
+
+fn canonical_kind(kind: String) -> String {
+    kind_index(&kind)
+        .map(|index| LINK_KINDS[index].to_owned())
+        .unwrap_or(kind)
+}
