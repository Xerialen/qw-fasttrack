+def _read_live_state() -> dict | None:
+    try:
+        state = json.loads(LIVE_STATE.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+    required = ("pid", "started_at", "nonce", "proxy", "ws")
