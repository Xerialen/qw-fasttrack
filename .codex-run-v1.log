 pub fn kind_index(kind: &str) -> Option<usize> {
-    LINK_KINDS.iter().position(|candidate| *candidate == kind)
+    LINK_KINDS
+        .iter()
+        .position(|candidate| candidate.eq_ignore_ascii_case(kind))
 }
 
+fn unique_index(ids: &[u32]) -> Option<HashMap<u32, usize>> {
+    let mut result = HashMap::with_capacity(ids.len());
+    for (index, id) in ids.iter().copied().enumerate() {
+        if result.insert(id, index).is_some() {
+            return None;
+        }
+    }
+    Some(result)
+}
+
+fn canonical_kind(kind: String) -> String {
+    kind_index(&kind)
+        .map(|index| LINK_KINDS[index].to_owned())
+        .unwrap_or(kind)
+}
