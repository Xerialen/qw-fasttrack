0080:             self._socket.close()
0081:         except OSError:
0082:             pass
0083: 
0084:     def _read(self, timeout: float):
0085:         deadline = time.monotonic() + timeout
0086:         while b"\n" not in self._buf:
0087:             remaining = deadline - time.monotonic()
0088:             if remaining <= 0:
0089:                 return None
0090:             self._socket.settimeout(max(remaining, 0.05))
0091:             try:
0092:                 chunk = self._socket.recv(65536)
0093:             except (TimeoutError, socket.timeout):
0094:                 return None
0095:             if not chunk:
0096:                 raise ControlError("control connection closed")
0097:             self._buf += chunk
0098:         line, self._buf = self._buf.split(b"\n", 1)
0099:         return json.loads(line.decode("utf-8", "replace"))
0100: 
0101:     def request(self, verb_and_args: str, timeout: float = 15.0) -> dict:
0102:         rid = self._next_id
0103:         self._next_id += 1
0104:         self._socket.sendall(f"{rid} {verb_and_args}\n".encode("ascii"))
0105:         deadline = time.monotonic() + timeout
0106:         while True:
0107:             remaining = deadline - time.monotonic()
0108:             if remaining <= 0:
0109:                 raise ControlError(f"request {verb_and_args!r} timed out")
0110:             msg = self._read(remaining)
0111:             if msg is None:
0112:                 continue
0113:             if "ev" in msg:
0114:                 self.events.append(msg)
0115:                 continue
0116:             if msg.get("id") == rid:
0117:                 if msg.get("ok") is not True:
0118:                     raise ControlError(str(msg.get("error")))
0119:                 return msg
0120: 
