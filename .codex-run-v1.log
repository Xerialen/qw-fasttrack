+        if let Some(gpu) = self.gpu.as_mut() {
+            gpu.set_live_surfaces(&live.surfaces);
+            gpu.set_live_lines(&live.lines);
+        }
+        if self.follow_live && let Some(bot) = frame.bots.first() {
+            let center = Vec3::from_array(bot.pos) + Vec3::Z * 24.0;
+            self.camera.frame(
+                center - Vec3::new(96.0, 96.0, 64.0),
+                center + Vec3::new(96.0, 96.0, 96.0),
+            );
+        }
+        self.live_frame = Some(frame);
+        self.refresh_graph_status();
+        self.request_redraw();
+    }
+
+    fn clear_live(&mut self, reason: &str) {
+        self.live_frame = None;
+        if let Some(gpu) = self.gpu.as_mut() {
+            gpu.set_live_surfaces(&[]);
+            gpu.set_live_lines(&[]);
+        }
+        set_graph_status(reason, true);
+        self.request_redraw();
     }
 
     fn refresh_graph_status(&self) {
