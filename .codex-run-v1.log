+import asyncio
+
+async def main():
+    async def handle(reader, writer):
+        print("accepted", flush=True)
+    server = await asyncio.start_server(handle, "127.0.0.1", 31989)
+    print(server.sockets[0].getsockname(), flush=True)
+    reader, writer = await asyncio.wait_for(asyncio.open_connection("127.0.0.1", 31989), 3)
+    print("connected", flush=True)
+    writer.close()
+    await writer.wait_closed()
+    server.close()
+    await server.wait_closed()
+
+asyncio.run(main())
