//! Parser for Nano/rtx-nav's exported navigation graph contract.

use glam::Vec3;
use serde::Deserialize;

pub const SCHEMA_V1: &str = "qw-nav-graph/1";
pub const LINK_KINDS: [&str; 10] = [
    "Walk",
    "Step",
    "Drop",
    "JumpGap",
    "DoubleJump",
    "SpeedJump",
    "Plat",
    "Teleport",
    "Hook",
    "RocketJump",
];

#[derive(Clone, Debug, Deserialize)]
pub struct GraphDocument {
    pub schema: String,
    pub map: String,
    pub grid: f32,
    pub cells: Vec<[f32; 3]>,
    #[serde(deserialize_with = "deserialize_links")]
    pub links: Vec<GraphLink>,
}

#[derive(Clone, Debug)]
pub struct GraphLink {
    pub from: usize,
    pub to: usize,
    pub kind: String,
    pub cost: f32,
}

impl GraphDocument {
    pub fn parse(json: &str) -> Result<Self, String> {
        let mut graph: Self = serde_json::from_str(json).map_err(|error| error.to_string())?;
        if graph.schema != SCHEMA_V1 {
            return Err(format!(
                "unsupported graph schema {:?}; expected {SCHEMA_V1}",
                graph.schema
            ));
        }
        graph.map = graph.map.trim().trim_end_matches(".bsp").to_owned();
        if graph.map.is_empty() {
            return Err("graph map must not be empty".into());
        }
        if !graph.grid.is_finite() || graph.grid <= 0.0 {
            return Err("graph grid must be a positive finite number".into());
        }
        if graph
            .cells
            .iter()
            .flatten()
            .any(|coordinate| !coordinate.is_finite())
        {
            return Err("graph contains a non-finite cell coordinate".into());
        }
        for (index, link) in graph.links.iter().enumerate() {
            if link.from >= graph.cells.len() || link.to >= graph.cells.len() {
                return Err(format!(
                    "graph link {index} references cell {}→{} but only {} cells exist",
                    link.from,
                    link.to,
                    graph.cells.len()
                ));
            }
            if !link.cost.is_finite() || link.cost < 0.0 {
                return Err(format!("graph link {index} has invalid cost {}", link.cost));
            }
        }
        Ok(graph)
    }

    pub fn cell(&self, index: usize) -> Vec3 {
        Vec3::from_array(self.cells[index])
    }
}

pub fn kind_index(kind: &str) -> Option<usize> {
    LINK_KINDS.iter().position(|candidate| *candidate == kind)
}

fn deserialize_links<'de, D>(deserializer: D) -> Result<Vec<GraphLink>, D::Error>
where
    D: serde::Deserializer<'de>,
{
    let links = Vec::<(usize, usize, String, f32)>::deserialize(deserializer)?;
    Ok(links
        .into_iter()
        .map(|(from, to, kind, cost)| GraphLink {
            from,
            to,
            kind,
            cost,
        })
        .collect())
}

#[cfg(test)]
mod tests {
    use super::{GraphDocument, kind_index};

    #[test]
    fn parses_v1_and_ignores_unknown_fields() {
        let graph = GraphDocument::parse(
            r#"{
              "schema":"qw-nav-graph/1", "map":"dm3.bsp", "grid":32,
              "cells":[[0,0,24],[32,0,24]],
              "links":[[0,1,"Walk",0.1],[1,0,"FutureKind",0.2]],
              "producer":{"sha":"abc"},
              "speed_jump_traversals":[{
                "link_index":1,"link_id":40078,"payload_present":true,
                "traversal":{"psi":270,"psi_source":"ground_turn.runway_yaw",
                  "ground_turn":{"version":3,"blended_runway":true,
                    "launchbox":{"min":[0,0,0],"max":[1,1,1]}}}
              }]
            }"#,
        )
        .unwrap();
        assert_eq!(graph.map, "dm3");
        assert_eq!(graph.cell(1).to_array(), [32.0, 0.0, 24.0]);
        assert_eq!(graph.links[0].kind, "Walk");
        assert_eq!(kind_index("RocketJump"), Some(9));
        assert_eq!(kind_index("FutureKind"), None);
    }

    #[test]
    fn rejects_wrong_schema_bad_grid_and_bad_indices() {
        assert!(
            GraphDocument::parse(
                r#"{"schema":"qw-nav-graph/2","map":"dm3","grid":32,"cells":[],"links":[]}"#
            )
            .is_err()
        );
        assert!(
            GraphDocument::parse(
                r#"{"schema":"qw-nav-graph/1","map":"dm3","grid":0,"cells":[],"links":[]}"#
            )
            .is_err()
        );
        assert!(GraphDocument::parse(r#"{"schema":"qw-nav-graph/1","map":"dm3","grid":32,"cells":[[0,0,0]],"links":[[0,1,"Walk",1]]}"#).is_err());
    }
}


===== overlay.rs =====
use glam::Vec3;
use nav_core::{LinkKind, NavGraph, NearCellKind, NearField, PathPlan};

use crate::annotation_data::{AnnotationArrow, AnnotationDocument};
use crate::geom::ColorVertex;
use crate::graph_data::{GraphDocument, kind_index};
use crate::overlay_data::{Marker, Polyline};
use crate::patch_data::{PatchAdd, PatchRemove};

pub const BAND_COLORS: [[f32; 3]; 4] = [
    [1.00, 0.10, 0.08], // slow / chain broken
    [1.00, 0.58, 0.05], // running
    [0.85, 0.95, 0.08], // fast
    [0.05, 1.00, 0.24], // preserved bhop
];

pub struct Overlay {
    pub surfaces: Vec<ColorVertex>,
    pub lines: Vec<ColorVertex>,
}

pub struct BuildInput<'a> {
    pub graph: &'a NavGraph,
    pub show_local_graph: bool,
    pub show_exported_graph: bool,
    pub exported_graph: Option<&'a GraphDocument>,
    pub graph_kinds: &'a [bool; 10],
    pub patch_adds: &'a [PatchAdd],
    pub patch_removes: &'a [PatchRemove],
    pub annotations: &'a AnnotationDocument,
    pub annotation_preview: Option<&'a AnnotationArrow>,
    pub edit_source: Option<usize>,
    pub selected_add: Option<usize>,
    pub near: Option<&'a NearField>,
    pub plan: Option<&'a PathPlan>,
    pub ghost: Option<Vec3>,
    pub goal: Option<Vec3>,
    pub glide: Option<(Vec3, Vec3)>,
    pub overlay_routes: &'a [PathPlan],
    pub truth_routes: &'a [Vec<Vec3>],
    pub markers: &'a [Marker],
    pub polylines: &'a [Polyline],
}

pub fn build(input: BuildInput<'_>) -> Overlay {
    let BuildInput {
        graph,
        show_local_graph,
        show_exported_graph,
        exported_graph,
        graph_kinds,
        patch_adds,
        patch_removes,
        annotations,
        annotation_preview,
        edit_source,
        selected_add,
        near,
        plan,
        ghost,
        goal,
        glide,
        overlay_routes,
        truth_routes,
        markers,
        polylines,
    } = input;
    let mut surfaces = Vec::new();
    let mut lines = Vec::new();

    // This graph is a useful diagnostic carve, but it is not Nano's runtime navigation truth.
    if show_local_graph {
        for cell in &graph.cells {
            tile(
                &mut surfaces,
                cell.origin - Vec3::Z * 23.2,
                12.5,
                [0.08, 0.38, 0.12],
            );
        }
        for link in &graph.links {
            if link.kind == LinkKind::Walk {
                continue;
            }
            let color = match link.kind {
                LinkKind::Step => [0.72, 0.70, 0.10],
                LinkKind::Drop => [0.88, 0.38, 0.05],
                LinkKind::Jump => [0.85, 0.12, 0.75],
                LinkKind::Walk => [0.1, 0.4, 0.1],
            };
            line(
                &mut lines,
                graph.cells[link.from].origin,
                graph.cells[link.to].origin,
                color,
            );
        }
    }

    // Producer-exported cells and links are the real Nano mesh. Unknown future link kinds stay
    // visible in neutral grey so a newer producer never silently loses graph connectivity here.
    if show_exported_graph && let Some(exported) = exported_graph {
        let half = (exported.grid * 0.38).clamp(3.0, 24.0);
        for index in 0..exported.cells.len() {
            tile(
                &mut surfaces,
                exported.cell(index) - Vec3::Z * 23.0,
                half,
                [0.04, 0.30, 0.34],
            );
        }
        for (link_index, link_data) in exported.links.iter().enumerate() {
            if kind_index(&link_data.kind).is_some_and(|index| !graph_kinds[index]) {
                continue;
            }
            if patch_removes.iter().any(|remove| remove.link == link_index) {
                continue;
            }
            let color = graph_kind_color(&link_data.kind);
            line(
                &mut lines,
                exported.cell(link_data.from) + Vec3::Z * 2.0,
                exported.cell(link_data.to) + Vec3::Z * 2.0,
                color,
            );
        }
        for remove in patch_removes {
            dashed_line(
                &mut lines,
                Vec3::from_array(remove.from) + Vec3::Z * 5.0,
                Vec3::from_array(remove.to) + Vec3::Z * 5.0,
                [1.0, 0.08, 0.06],
            );
            cross(
                &mut lines,
                (Vec3::from_array(remove.from) + Vec3::from_array(remove.to)) * 0.5 + Vec3::Z * 7.0,
                9.0,
                [1.0, 0.08, 0.06],
            );
        }
        for (index, add) in patch_adds.iter().enumerate() {
            let color = if selected_add == Some(index) {
                [1.0, 1.0, 1.0]
            } else {
                [0.0, 1.0, 0.82]
            };
            let from = Vec3::from_array(add.from) + Vec3::Z * 7.0;
            let takeoff = Vec3::from_array(add.takeoff) + Vec3::Z * 7.0;
            let to = Vec3::from_array(add.to) + Vec3::Z * 7.0;
            dashed_line(&mut lines, from, takeoff, color);
            dashed_line(&mut lines, takeoff, to, color);
            cuboid(
                &mut surfaces,
                takeoff,
                Vec3::splat(if selected_add == Some(index) {
                    7.0
                } else {
                    5.0
                }),
                [1.0, 0.18, 0.86],
            );
            cross(&mut lines, takeoff, 10.0, [1.0, 0.18, 0.86]);
        }
        if let Some(source) = edit_source.filter(|&index| index < exported.cells.len()) {
            let position = exported.cell(source) + Vec3::Z * 7.0;
            cuboid(&mut surfaces, position, Vec3::splat(8.0), [1.0, 0.82, 0.04]);
            cross(&mut lines, position, 15.0, [1.0, 0.82, 0.04]);
        }
    }

    if let Some(near) = near {
        for cell in near.cells() {
            let color = match cell.kind {
                NearCellKind::Walkable => [0.05, 0.42, 1.00],
                NearCellKind::Wall => [1.00, 0.08, 0.06],
                NearCellKind::Drop => [1.00, 0.32, 0.03],
                NearCellKind::Hazard => [0.80, 0.04, 0.95],
                NearCellKind::Unreachable => [0.45, 0.05, 0.05],
            };
            let z = cell.floor_z.unwrap_or(cell.center.z) - 22.5;
            tile(
                &mut surfaces,
                Vec3::new(cell.center.x, cell.center.y, z),
                3.35,
                color,
            );
        }
    }

    if let Some(plan) = plan {
        path(&mut lines, plan);
    }
    for plan in overlay_routes {
        path(&mut lines, plan);
    }
    for points in truth_routes {
        truth_path(&mut lines, points);
    }

    for polyline in polylines {
        debug_assert!(
            !polyline.name.is_empty(),
            "overlay polyline should be named"
        );
        let color = polyline.rgb();
        let points: Vec<Vec3> = polyline.positions().collect();
        for pair in points.windows(2) {
            line(
                &mut lines,
                pair[0] + Vec3::Z * 4.0,
                pair[1] + Vec3::Z * 4.0,
                color,
            );
        }
    }

    for marker in markers {
        debug_assert!(!marker.name.is_empty(), "overlay marker should be named");
        let position = marker.position();
        let color = marker_color(&marker.kind);
        cuboid(
            &mut surfaces,
            position + Vec3::Z * 4.0,
            Vec3::splat(7.0),
            color,
        );
        cross(&mut lines, position + Vec3::Z * 15.0, 13.0, color);
    }

    for layer in annotations.layers.iter().filter(|layer| layer.visible) {
        for arrow in &layer.arrows {
            annotation_arrow(&mut lines, arrow, false);
        }
    }
    if let Some(preview) = annotation_preview {
        annotation_arrow(&mut lines, preview, true);
    }

    if let Some(ghost) = ghost {
        cuboid(
            &mut surfaces,
            ghost + Vec3::Z * 4.0,
            Vec3::new(12.0, 12.0, 28.0),
            [0.08, 0.78, 1.0],
        );
        cross(&mut lines, ghost + Vec3::Z * 35.0, 18.0, [0.20, 0.95, 1.0]);
    }
    if let Some(goal) = goal {
        cuboid(
            &mut surfaces,
            goal + Vec3::Z * 3.0,
            Vec3::splat(9.0),
            [1.0, 0.15, 0.82],
        );
        cross(&mut lines, goal + Vec3::Z * 18.0, 16.0, [1.0, 0.20, 0.85]);
    }
    if let Some((start, end)) = glide {
        // Doubled with a small lift so the exact chord stays unmistakable over the coarse path.
        line(
            &mut lines,
            start + Vec3::Z * 11.0,
            end + Vec3::Z * 11.0,
            [0.00, 1.00, 1.00],
        );
        line(
            &mut lines,
            start + Vec3::new(0.0, 0.8, 12.0),
            end + Vec3::new(0.0, 0.8, 12.0),
            [1.00, 1.00, 1.00],
        );
    }

    Overlay { surfaces, lines }
}

pub fn graph_kind_color(kind: &str) -> [f32; 3] {
    match kind {
        "Walk" => [0.15, 0.88, 0.24],
        "Step" => [0.95, 0.82, 0.10],
        "Drop" => [1.00, 0.39, 0.06],
        "JumpGap" => [1.00, 0.10, 0.12],
        "DoubleJump" => [0.94, 0.10, 0.82],
        "SpeedJump" => [1.00, 0.35, 0.66],
        "Plat" => [0.08, 0.88, 0.92],
        "Teleport" => [0.12, 0.42, 1.00],
        "Hook" => [0.55, 0.24, 0.95],
        "RocketJump" => [1.00, 1.00, 1.00],
        _ => [0.65, 0.68, 0.72],
    }
}

fn path(lines: &mut Vec<ColorVertex>, plan: &PathPlan) {
    for segment in &plan.segments {
        let color = BAND_COLORS[segment.band.index()];
        let lift = Vec3::Z * 7.0;
        line(lines, segment.from + lift, segment.to + lift, color);
        // Vertical ticks make band changes readable even in a dense graph.
        line(
            lines,
            segment.to + Vec3::Z * 3.0,
            segment.to + Vec3::Z * 12.0,
            color,
        );
    }
}

fn truth_path(lines: &mut Vec<ColorVertex>, points: &[Vec3]) {
    let color = [0.00, 1.00, 0.82];
    for pair in points.windows(2) {
        let lift = Vec3::Z * 10.0;
        line(lines, pair[0] + lift, pair[1] + lift, color);
        line(
            lines,
            pair[1] + Vec3::Z * 4.0,
            pair[1] + Vec3::Z * 16.0,
            color,
        );
    }
}

pub fn marker_color(kind: &str) -> [f32; 3] {
    match kind {
        "spawn" => [0.12, 0.88, 1.00],
        "item" => [1.00, 0.82, 0.08],
        "rj-start" => [1.00, 0.24, 0.08],
        "rj-goal" => [0.95, 0.10, 0.85],
        _ => [0.75, 0.78, 0.84],
    }
}

fn vertex(pos: Vec3, color: [f32; 3]) -> ColorVertex {
    ColorVertex {
        pos: pos.to_array(),
        color,
    }
}
fn line(out: &mut Vec<ColorVertex>, a: Vec3, b: Vec3, color: [f32; 3]) {
    out.push(vertex(a, color));
    out.push(vertex(b, color));
}

fn dashed_line(out: &mut Vec<ColorVertex>, a: Vec3, b: Vec3, color: [f32; 3]) {
    let length = a.distance(b);
    if length <= f32::EPSILON {
        return;
    }
    let direction = (b - a) / length;
    let mut at = 0.0;
    while at < length {
        let end = (at + 10.0).min(length);
        line(out, a + direction * at, a + direction * end, color);
        at += 16.0;
    }
}

fn annotation_arrow(out: &mut Vec<ColorVertex>, arrow: &AnnotationArrow, preview: bool) {
    let lift = Vec3::Z * if preview { 18.0 } else { 14.0 };
    let from = arrow.start_position() + lift;
    let to = arrow.end_position() + lift;
    let delta = to - from;
    let length = delta.length();
    if length <= f32::EPSILON {
        return;
    }
    let direction = delta / length;
    let mut side = Vec3::Z.cross(direction).normalize_or_zero();
    if side.length_squared() <= f32::EPSILON {
        side = Vec3::X;
    }
    let color = if preview {
        [1.0, 1.0, 1.0]
    } else {
        arrow.rgb()
    };
    let offset = side * 1.2;
    line(out, from, to, color);
    line(out, from + offset, to + offset, color);
    let head = length.mul_add(0.22, 0.0).clamp(12.0, 32.0);
    let wing = head * 0.48;
    line(out, to, to - direction * head + side * wing, color);
    line(out, to, to - direction * head - side * wing, color);
    cross(out, from, if preview { 7.0 } else { 5.0 }, color);
}

fn tile(out: &mut Vec<ColorVertex>, center: Vec3, half: f32, color: [f32; 3]) {
    let a = center + Vec3::new(-half, -half, 0.0);
    let b = center + Vec3::new(half, -half, 0.0);
    let c = center + Vec3::new(half, half, 0.0);
    let d = center + Vec3::new(-half, half, 0.0);
    for p in [a, b, c, a, c, d] {
        out.push(vertex(p, color));
    }
}

fn cross(out: &mut Vec<ColorVertex>, center: Vec3, radius: f32, color: [f32; 3]) {
    line(
        out,
        center - Vec3::X * radius,
        center + Vec3::X * radius,
        color,
    );
    line(
        out,
        center - Vec3::Y * radius,
        center + Vec3::Y * radius,
        color,
    );
    line(
        out,
        center - Vec3::Z * radius,
        center + Vec3::Z * radius,
        color,
    );
}

fn cuboid(out: &mut Vec<ColorVertex>, center: Vec3, half: Vec3, color: [f32; 3]) {
    let p = |x: f32, y: f32, z: f32| center + Vec3::new(x * half.x, y * half.y, z * half.z);
    let corners = [
        p(-1., -1., -1.),
        p(1., -1., -1.),
        p(1., 1., -1.),
        p(-1., 1., -1.),
        p(-1., -1., 1.),
        p(1., -1., 1.),
        p(1., 1., 1.),
        p(-1., 1., 1.),
    ];
    for [a, b, c, d] in [
        [0, 2, 1, 3],
        [4, 5, 6, 7],
        [0, 1, 5, 4],
        [1, 2, 6, 5],
        [2, 3, 7, 6],
        [3, 0, 4, 7],
    ] {
        for i in [a, b, c, a, c, d] {
            out.push(vertex(corners[i], color));
        }
    }
}


