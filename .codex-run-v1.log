+            f"--working-directory={VIEWER_WORKTREE}", "--property=Nice=19", "--",
+            "nice", "-n", "19", str(trunk), "serve", "--port", "8090", "--address", "127.0.0.1",
+        )
+        viewer_started = True
+        STATE_DIR.mkdir(parents=True, exist_ok=True)
