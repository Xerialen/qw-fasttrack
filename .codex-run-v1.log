+    fn install_live_frame(&mut self, frame: LiveFrame) {
+        let matches = self.exported_graph.as_ref().is_some_and(|(name, graph)| {
+            name == &frame.graph.name
+                && graph.cells.len() == frame.graph.cells
+                && graph.links.len() == frame.graph.links
+                && graph.sha256 == frame.graph.sha256
+        });
+        if !matches {
+            set_graph_status("live: graph mismatch", true);
+            if let Some(gpu) = self.gpu.as_mut() {
+                gpu.set_live_surfaces(&[]);
+                gpu.set_live_lines(&[]);
