//! Parser for Nano/rtx-nav's exported navigation graph contract.

use glam::Vec3;
use serde::Deserialize;

pub const SCHEMA_V1: &str = "qw-nav-graph/1";
pub const LINK_KINDS: [&str; 10] = [
    "Walk",
    "Step",
    "Drop",
    "JumpGap",
    "DoubleJump",
    "SpeedJump",
    "Plat",
    "Teleport",
    "Hook",
    "RocketJump",
];

#[derive(Clone, Debug, Deserialize)]
pub struct GraphDocument {
    pub schema: String,
    pub map: String,
    pub grid: f32,
    pub cells: Vec<[f32; 3]>,
    #[serde(deserialize_with = "deserialize_links")]
    pub links: Vec<GraphLink>,
}

#[derive(Clone, Debug)]
pub struct GraphLink {
    pub from: usize,
    pub to: usize,
    pub kind: String,
    pub cost: f32,
}

impl GraphDocument {
    pub fn parse(json: &str) -> Result<Self, String> {
        let mut graph: Self = serde_json::from_str(json).map_err(|error| error.to_string())?;
        if graph.schema != SCHEMA_V1 {
            return Err(format!(
                "unsupported graph schema {:?}; expected {SCHEMA_V1}",
                graph.schema
            ));
        }
        graph.map = graph.map.trim().trim_end_matches(".bsp").to_owned();
        if graph.map.is_empty() {
            return Err("graph map must not be empty".into());
        }
        if !graph.grid.is_finite() || graph.grid <= 0.0 {
            return Err("graph grid must be a positive finite number".into());
        }
        if graph
            .cells
            .iter()
            .flatten()
            .any(|coordinate| !coordinate.is_finite())
        {
            return Err("graph contains a non-finite cell coordinate".into());
        }
        for (index, link) in graph.links.iter().enumerate() {
            if link.from >= graph.cells.len() || link.to >= graph.cells.len() {
                return Err(format!(
                    "graph link {index} references cell {}→{} but only {} cells exist",
                    link.from,
                    link.to,
                    graph.cells.len()
                ));
            }
            if !link.cost.is_finite() || link.cost < 0.0 {
                return Err(format!("graph link {index} has invalid cost {}", link.cost));
            }
        }
        Ok(graph)
    }

    pub fn cell(&self, index: usize) -> Vec3 {
        Vec3::from_array(self.cells[index])
    }
}

pub fn kind_index(kind: &str) -> Option<usize> {
    LINK_KINDS.iter().position(|candidate| *candidate == kind)
}

fn deserialize_links<'de, D>(deserializer: D) -> Result<Vec<GraphLink>, D::Error>
where
    D: serde::Deserializer<'de>,
{
    let links = Vec::<(usize, usize, String, f32)>::deserialize(deserializer)?;
    Ok(links
        .into_iter()
        .map(|(from, to, kind, cost)| GraphLink {
            from,
            to,
            kind,
            cost,
        })
        .collect())
}

#[cfg(test)]
mod tests {
    use super::{GraphDocument, kind_index};

    #[test]
    fn parses_v1_and_ignores_unknown_fields() {
        let graph = GraphDocument::parse(
            r#"{
              "schema":"qw-nav-graph/1", "map":"dm3.bsp", "grid":32,
              "cells":[[0,0,24],[32,0,24]],
              "links":[[0,1,"Walk",0.1],[1,0,"FutureKind",0.2]],
              "producer":{"sha":"abc"},
              "speed_jump_traversals":[{
                "link_index":1,"link_id":40078,"payload_present":true,
                "traversal":{"psi":270,"psi_source":"ground_turn.runway_yaw",
                  "ground_turn":{"version":3,"blended_runway":true,
                    "launchbox":{"min":[0,0,0],"max":[1,1,1]}}}
              }]
            }"#,
        )
        .unwrap();
        assert_eq!(graph.map, "dm3");
        assert_eq!(graph.cell(1).to_array(), [32.0, 0.0, 24.0]);
        assert_eq!(graph.links[0].kind, "Walk");
        assert_eq!(kind_index("RocketJump"), Some(9));
        assert_eq!(kind_index("FutureKind"), None);
    }

    #[test]
    fn rejects_wrong_schema_bad_grid_and_bad_indices() {
        assert!(
            GraphDocument::parse(
                r#"{"schema":"qw-nav-graph/2","map":"dm3","grid":32,"cells":[],"links":[]}"#
            )
            .is_err()
        );
        assert!(
            GraphDocument::parse(
                r#"{"schema":"qw-nav-graph/1","map":"dm3","grid":0,"cells":[],"links":[]}"#
            )
            .is_err()
        );
        assert!(GraphDocument::parse(r#"{"schema":"qw-nav-graph/1","map":"dm3","grid":32,"cells":[[0,0,0]],"links":[[0,1,"Walk",1]]}"#).is_err());
    }
}


