+def _wait_for_state(timeout_s: float = 45.0) -> dict:
+    deadline = time.monotonic() + timeout_s
+    while time.monotonic() < deadline:
+        state = _read_live_state()
+        if state is not None:
+            return state
+        if not _unit_active(LIVE_UNIT):
