0389:     let d = center + Vec3::new(-half, half, 0.0);
0390:     for p in [a, b, c, a, c, d] {
0391:         out.push(vertex(p, color));
0392:     }
0393: }
0394: 
0395: fn cross(out: &mut Vec<ColorVertex>, center: Vec3, radius: f32, color: [f32; 3]) {
0396:     line(
0397:         out,
0398:         center - Vec3::X * radius,
0399:         center + Vec3::X * radius,
0400:         color,
0401:     );
0402:     line(
0403:         out,
0404:         center - Vec3::Y * radius,
0405:         center + Vec3::Y * radius,
0406:         color,
0407:     );
0408:     line(
0409:         out,
0410:         center - Vec3::Z * radius,
0411:         center + Vec3::Z * radius,
0412:         color,
0413:     );
0414: }
0415: 
0416: fn cuboid(out: &mut Vec<ColorVertex>, center: Vec3, half: Vec3, color: [f32; 3]) {
0417:     let p = |x: f32, y: f32, z: f32| center + Vec3::new(x * half.x, y * half.y, z * half.z);
0418:     let corners = [
0419:         p(-1., -1., -1.),
0420:         p(1., -1., -1.),
0421:         p(1., 1., -1.),
0422:         p(-1., 1., -1.),
0423:         p(-1., -1., 1.),
0424:         p(1., -1., 1.),
0425:         p(1., 1., 1.),
0426:         p(-1., 1., 1.),
0427:     ];
0428:     for [a, b, c, d] in [
0429:         [0, 2, 1, 3],
0430:         [4, 5, 6, 7],
0431:         [0, 1, 5, 4],
0432:         [1, 2, 6, 5],
0433:         [2, 3, 7, 6],
0434:         [3, 0, 4, 7],
0435:     ] {
0436:         for i in [a, b, c, a, c, d] {
0437:             out.push(vertex(corners[i], color));
0438:         }
0439:     }
0440: }

