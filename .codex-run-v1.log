+pub fn build_live(graph: &GraphDocument, frame: &LiveFrame) -> Overlay {
+    let mut surfaces = Vec::new();
+    let mut lines = Vec::new();
+    let half = (graph.grid * 0.42).clamp(4.0, 26.0);
+
+    for bot in &frame.bots {
+        for cell_id in &bot.used.cells {
+            if let Some(index) = graph.cell_index_by_id.get(cell_id) {
+                tile(
+                    &mut surfaces,
+                    graph.cell(*index) - Vec3::Z * 21.5,
+                    half,
+                    [0.52, 0.12, 0.02],
+                );
+            }
+        }
+        if let Some(index) = bot.cell_id.and_then(|id| graph.cell_index_by_id.get(&id).copied()) {
+            tile(
+                &mut surfaces,
+                graph.cell(index) - Vec3::Z * 20.5,
+                half,
+                [1.00, 0.92, 0.04],
+            );
+        }
+        let link_count = bot.used.links.len().max(1) as f32;
+        for (order, link_id) in bot.used.links.iter().enumerate() {
+            let Some(index) = graph.link_index_by_id.get(link_id).copied() else { continue };
+            let link_data = &graph.links[index];
+            let heat = order as f32 / link_count;
+            let color = [1.0, 0.88 - 0.72 * heat, 0.01];
+            let lift = Vec3::Z * 8.0;
+            line(
+                &mut lines,
+                graph.cell(link_data.from) + lift,
+                graph.cell(link_data.to) + lift,
+                color,
+            );
+        }
+        wire_cuboid(
+            &mut lines,
+            Vec3::from_array(bot.pos) + Vec3::Z * 16.0,
+            Vec3::new(12.0, 12.0, 28.0),
+            [1.0, 0.98, 0.15],
+        );
+    }
+    Overlay { surfaces, lines }
+}
