+++ b/fasttrack/tests/fixtures/sng_status_sequence.json
@@ -0,0 +1,12 @@
+{
+  "schema": "qw-fasttrack-status-sequence/1",
+  "source": "recorded dm3 stairs-to-SNG live jump; positions/cells only",
+  "planted_link_id": 50259,
+  "samples": [
